#!/usr/bin/env python3
"""Scan opencode/claude agent rosters -> deterministic delegation artifact.

Frontmatter schemas:
  OpenCode agents: https://opencode.ai/docs/agents
  Claude Code sub-agents: https://code.claude.com/docs/en/sub-agents

--live (opt-in): resolve ROUTE_MAP lanes against host OAuth auth.json top-level
keys (never values) via PROVIDER_KEY_MAP + LIVE_CHAINS ordered fallback.
Model-level validity note: provider presence != per-model entitlement; models
verified registered via `xask plan` on ship date. Documented assumption only;
no runtime check (leanness). No subprocess/network/shell: auth keys + static
data. Missing/unreadable auth -> all live routes null + 'no-auth-provider'
warnings; exit code unchanged. Without --live: byte-identical legacy schema.
"""
import os,sys,json,re,hashlib,tempfile

NAME_RE=re.compile(r'^[a-z][a-z0-9_-]{0,63}$')
OP_MAP={'orch':['orchestration','judging'],'the-planner':['planning'],'the-scout':['research','prior-art'],'the-reviewer':['code-review','correctness'],'the-labrat':['empirical-probe'],'the-executor':['implementation'],'the-critic':['approach-critique'],'the-sentinel':['security-audit'],'the-distiller':['synthesis','dedup'],'the-connector':['cross-axis-patterns'],'the-simplifier':['yagni','deletion'],'the-revenger':['reverse-engineering'],'the-mutation-tester':['test-validation','mutation'],'the-netsshark':['network-audit'],'the-scribe':['reporting','commits'],'the-architect':['architecture','boundaries'],'the-judge':['orchestration','arbitration']}
ROUTE_MAP={'the-critic':{'provider':'opencode-go','model_id':'ox-alpha-free'},'the-reviewer':{'provider':'opencode-go','model_id':'ox-alpha-free'},'the-mutation-tester':{'provider':'opencode-go','model_id':'ox-alpha-free'},'the-sentinel':{'provider':'grok','model_id':'grok-4.6'},'the-revenger':{'provider':'opencode-go','model_id':'ox-alpha-free'},'the-labrat':{'provider':'grok','model_id':'grok-4.6'},'the-netsshark':{'provider':'grok','model_id':'grok-4.6'},'the-scout':{'provider':'opencode-go','model_id':'ox-alpha-free'},'the-distiller':{'provider':'opencode-go','model_id':'ox-alpha-free'},'the-executor':{'provider':'opencode-go','model_id':'ox-alpha-free'},'the-planner':{'provider':'opencode-go','model_id':'ox-alpha-free'},'the-architect':{'provider':'opencode-go','model_id':'ox-alpha-free'},'the-connector':{'provider':'opencode-go','model_id':'ox-alpha-free'},'the-simplifier':{'provider':'opencode-go','model_id':'ox-alpha-free'},'the-scribe':{'provider':'opencode-go','model_id':'ox-alpha-free'}}
CLAUDE_ROUTE_MAP={}
PROVIDER_KEY_MAP={'openai':'chatgpt','xai':'grok','alibaba-token-plan':'token-plan','opencode-go':'opencode-go'}
LIVE_CHAINS={'the-revenger':[('opencode-go','ox-alpha-free')],'the-critic':[('opencode-go','ox-alpha-free')],'the-reviewer':[('opencode-go','ox-alpha-free')],'the-mutation-tester':[('opencode-go','ox-alpha-free')],'the-sentinel':[('grok','grok-4.6'),('opencode-go','ox-alpha-free')],'the-labrat':[('grok','grok-4.6'),('opencode-go','ox-alpha-free')],'the-netsshark':[('grok','grok-4.6'),('opencode-go','ox-alpha-free')],'the-scout':[('opencode-go','ox-alpha-free')],'the-distiller':[('opencode-go','ox-alpha-free')],'the-executor':[('opencode-go','ox-alpha-free')],'the-planner':[('opencode-go','ox-alpha-free')],'the-architect':[('opencode-go','ox-alpha-free')],'the-connector':[('opencode-go','ox-alpha-free')],'the-simplifier':[('opencode-go','ox-alpha-free')],'the-scribe':[('opencode-go','ox-alpha-free')]}
def san(x):
 if x is None:return None
 x=str(x).replace('`',"'").replace('|','\\|').replace('---','—')
 x=''.join(c for c in x if not ((ord(c)<32 or 127<=ord(c)<=159) and c not in '\t\r\n'))
 x=x.replace('\r',' ').replace('\n',' ').replace('\t',' ')
 x=' '.join(x.split()).strip()
 if not x:return None
 b=x.encode('utf-8')
 while len(b)>512:b=b[:-1]
 return b.decode('utf-8','ignore')
def sanpath(x):
 if x is None:return None
 x=''.join(c for c in str(x) if not ((ord(c)<32 or 127<=ord(c)<=159) and c not in '\t\r\n'))
 x=x.replace('\r',' ').replace('\n',' ').replace('\t',' ')
 return x.strip() or None
def parse(path):
 w=[]
 try:
  with open(path,'rb') as f: raw=f.read()
 except Exception as e:return None,'unreadable',str(e),w,b''
 s=raw.decode('utf-8','replace')
 if '�' in s:w.append('non-utf8-bytes')
 ls=s.splitlines()
 if not ls or ls[0].strip()!='---':return None,'parse_error','missing frontmatter',w,raw
 vals={}; extra={}; cur=None; closed=False
 for line in ls[1:]:
  if line.strip()=='---':closed=True;break
  if line.startswith((' ','\t')) and cur:
   vals[cur]=vals.get(cur,'')+' '+line.strip(); w.append('multi-line-value'); continue
  if ':' in line:
   k,v=line.split(':',1); k=k.strip(); v=v.strip()
   if len(v)>=2 and v[0]==v[-1] and v[0] in "\"'":v=v[1:-1]
   vals[k]=v; cur=k
  else: cur=None
 if not closed:return None,'parse_error','unclosed frontmatter',w,raw
 for k,v in vals.items():
  if k not in ('name','description','mode','model'):extra[k]=v
 return vals,'ok',None,w,raw
def main():
 args=sys.argv[1:]; ro=[]; out=None; runs=None; allow=False; live=False; i=0
 while i<len(args):
  if args[i]=='--roster' and i+1<len(args):ro.append(args[i+1]);i+=2
  elif args[i]=='--out' and i+1<len(args):out=args[i+1];i+=2
  elif args[i]=='--runs-dir' and i+1<len(args):runs=args[i+1];i+=2
  elif args[i]=='--allow-anywhere':allow=True;i+=1
  elif args[i]=='--live':live=True;i+=1
  else: print('usage error',file=sys.stderr);return 1
 home=os.path.realpath(os.path.expanduser('~'))
 defaults=[os.path.join(home,'.config/opencode/agents'),os.path.join(home,'.claude/agents')]
 dirs=ro or defaults
 def confined(p):
  r=os.path.realpath(p); return allow or r==home or r.startswith(home+os.sep)
 records=[]; rosters=[]; allbytes=[]; errors=0; stems={}
 for d in dirs:
  rd=os.path.realpath(d); oc=os.path.join(home,'.config/opencode'); cl=os.path.join(home,'.claude')
  source='opencode' if (rd==oc or rd.startswith(oc+os.sep)) else ('claude' if (rd==cl or rd.startswith(cl+os.sep)) else 'custom')
  if not confined(d): rosters.append({'dir':sanpath(d),'source':source,'status':'error','error':'outside $HOME (use --allow-anywhere)'}); errors+=1; continue
  if not os.path.isdir(d): rosters.append({'dir':sanpath(d),'source':source,'status':'error','error':'invalid roster directory'}); errors+=1; continue
  rosters.append({'dir':sanpath(d),'source':source,'status':'ok'})
  for fn in sorted(os.listdir(d)):
   if not fn.endswith('.md'):continue
   p=os.path.join(d,fn)
   try: st=os.lstat(p)
   except (FileNotFoundError,OSError):
    records.append({'id':source+'/'+fn[:-3],'name':fn[:-3],'source':source,'path':sanpath(p),'realpath':None,'symlink':False,'description':None,'mode':None,'model':None,'status':'unreadable','error':'vanished during scan','extra':{},'warnings':[],'shadows':None,'delegation':None});continue
   if not (os.path.isfile(p) or os.path.islink(p)):continue
   rp=os.path.realpath(p); sy=os.path.islink(p)
   if sy and not os.path.isfile(rp): rec={'id':source+'/'+fn[:-3],'name':fn[:-3],'source':source,'path':sanpath(p),'realpath':sanpath(rp),'symlink':True,'description':None,'mode':None,'model':None,'status':'unreadable','error':'broken symlink','extra':{},'warnings':[],'shadows':None,'delegation':None}; records.append(rec);continue
   if sy and not allow and rp!=home and not rp.startswith(home+os.sep):
    rec={'id':source+'/'+fn[:-3],'name':fn[:-3],'source':source,'path':sanpath(p),'realpath':sanpath(rp),'symlink':True,'description':None,'mode':None,'model':None,'status':'skipped','error':'symlink escapes $HOME (use --allow-anywhere)','extra':{},'warnings':[],'shadows':None,'delegation':None}; records.append(rec);continue
   vals,status,err,w,raw=parse(p)
   stem=fn[:-3]; name=(vals or {}).get('name') or stem; warn=list(w)
   if not NAME_RE.match(name):name=stem;warn.append('invalid-name')
   try: st2=os.lstat(p)
   except (FileNotFoundError,OSError):
    records.append({'id':source+'/'+stem,'name':san(name),'source':source,'path':sanpath(p),'realpath':sanpath(rp),'symlink':sy,'description':None,'mode':None,'model':None,'status':'unreadable','error':'vanished during scan','extra':{},'warnings':[],'shadows':None,'delegation':None});continue
   if (st2.st_ino,st2.st_dev)!=(st.st_ino,st.st_dev):
    rec={'id':source+'/'+stem,'name':san(name),'source':source,'path':sanpath(p),'realpath':sanpath(rp),'symlink':sy,'description':None,'mode':None,'model':None,'status':'skipped','error':'file changed during scan','extra':{},'warnings':[],'shadows':None,'delegation':None}; records.append(rec);continue
   allbytes.append((p,raw))
   rec={'id':source+'/'+stem,'name':san(name),'source':source,'path':sanpath(p),'realpath':sanpath(rp),'symlink':sy,'description':san((vals or {}).get('description')),'mode':san((vals or {}).get('mode')),'model':san((vals or {}).get('model')),'status':status,'error':san(err),'extra':{k2:v2 for k2,v2 in ((san(k),san(v)) for k,v in ((vals or {}).items() if vals else []) if k not in ('name','description','mode','model')) if k2 is not None},'warnings':warn,'shadows':None,'delegation':None}
   if source=='opencode' and stem in OP_MAP:rec['delegation']={'task_types':OP_MAP[stem],'dispatch_surface':'opencode','async':None,'model_route':ROUTE_MAP.get(stem)}
   elif source=='claude' and stem in ('the-almanacker','the-kimiraikkoner','the-musketeer','the-puppeteer'):rec['delegation']={'task_types':[],'dispatch_surface':'claude-code','async':True if rec['description'] and re.search('fire-and-forget|does not return',rec['description'],re.I) else None,'model_route':CLAUDE_ROUTE_MAP.get(stem)}
   if stem in stems:rec['shadows']=stems[stem]
   else:stems[stem]=rec['id']
   records.append(rec)
 records.sort(key=lambda x:x['id']); h=hashlib.sha256();
 for p,b in sorted(allbytes):h.update(b)
 providers=None
 if live:
  ap=os.environ.get('BOOTSTRAPPER_AUTH_FILE') or os.path.join(home,'.local/share/opencode/auth.json')
  try:
   with open(ap,'rb') as f: ak=json.loads(f.read().decode('utf-8','replace'))
   akeys=sorted(ak.keys()) if isinstance(ak,dict) else []
  except Exception:akeys=[]
  providers={k:PROVIDER_KEY_MAP.get(k,'unmapped') for k in akeys}
  avail={v for v in providers.values() if v!='unmapped'}
  for rec in records:
   dlg=rec.get('delegation'); stem=rec['id'].split('/',1)[1]
   if not dlg or rec['source']!='opencode' or stem not in LIVE_CHAINS:continue
   chain=LIVE_CHAINS[stem]; dlg['route_chain']=[p2+'/'+m2 for p2,m2 in chain]
   hit=next(((j,p2,m2) for j,(p2,m2) in enumerate(chain) if p2 in avail),None)
   if hit:dlg['model_route']={'provider':hit[1],'model_id':hit[2],'fallback_used':hit[0]>0}
   else:dlg['model_route']=None;rec['warnings'].append('no-auth-provider')
 gd=os.environ.get('GODSPEED_CORE_DIR') or os.path.join(home,'.agents/godspeed-core')
 gp=os.path.join(gd,'directive.md'); g=None
 if os.path.isfile(gp):
  with open(gp,'rb') as f:g=hashlib.sha256(f.read()).hexdigest()
 obj={'schema_version':1,'source_hash':h.hexdigest(),'godspeed_directive_sha256':g,'rosters':sorted(rosters,key=lambda r:r['dir'] or ''),'agents':records,'collisions':[],'parse_errors':[{'path':r['path'],'error':r['error']} for r in records if r['status']=='parse_error']}
 if live:obj['providers']=providers
 data=json.dumps(obj,sort_keys=True,indent=2,ensure_ascii=True)+'\n'
 def emit(dest):
  od=os.path.dirname(os.path.realpath(dest)) or '.'; fd,tmp=tempfile.mkstemp(dir=od); os.chmod(tmp,0o600)
  with os.fdopen(fd,'w',encoding='utf-8',newline='') as f:f.write(data)
  os.replace(tmp,dest)
 rdest=None
 if runs is not None:
  rr=os.path.realpath(runs)
  if not confined(runs) or os.path.islink(runs) or not os.path.isdir(rr):print('invalid runs dir',file=sys.stderr);return 1
  rdest=os.path.join(rr,h.hexdigest()+'.json')
  if os.path.islink(rdest):print('invalid runs destination',file=sys.stderr);return 1
 if out:
  if not confined(out) or os.path.islink(out):print('invalid output',file=sys.stderr);return 1
  emit(out)
 else:sys.stdout.write(data)
 if rdest:emit(rdest)
 if records==[] and rosters and errors==len(rosters):return 2
 return 0
if __name__=='__main__':sys.exit(main())
